flowchart TD
  r_boot["Boot: pick version, load settings"]
  r_frame0["Frame 0: the still, then the canvas takes over"]
  r_hold["Hold on the QR, then auto-start"]
  r_scan["Scan sweep + finder lock + buzz"]
  r_fill["QR grows to fill the screen"]
  bp_sheet(["blueprint: QR inverts into a blueprint sheet"])
  bp_wire(["blueprint: elevation draws, lifts off as wireframe, stands up"])
  bp_fill(["blueprint: real unit scans in part by part"])
  r_camera["Camera: top-down to eye level, glide, framing"]
  r_env["Sky, horizon, ground and floor colours"]
  r_lights["Light cycle: green, amber, red"]
  r_boom["Boom comes down"]
  r_dest["Leave to the DEST page"]
